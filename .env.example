# Frontend: use somente a URL e a chave publishable do Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE

# Tradução Português → Libras exige um provedor oficial autorizado para o domínio.
# Opções: rybena, handtalk ou none. Sem provedor, o app não simula tradução.
VITE_LIBRAS_PROVIDER=none
VITE_HANDTALK_TOKEN=

# NÃO coloque OPENAI_API_KEY neste arquivo nem em variáveis VITE_*.
# Configure-a como secret da Supabase Edge Function.
